# Required for the default OpenAI model.
OPENAI_API_KEY=sk-your-openai-api-key

# LangChain model identifier. You can swap providers if you install the provider package.
VIOLA_MODEL=openai:gpt-4.1-mini
VIOLA_TEMPERATURE=0.3
VIOLA_MAX_RETRIES=6
VIOLA_REQUEST_TIMEOUT=60

# Assistant behavior and local storage.
VIOLA_DEFAULT_TIMEZONE=Asia/Calcutta
VIOLA_DATA_DIR=.viola_data

# Optional: enables Tavily search. Without this, Viola uses the DuckDuckGo fallback.
TAVILY_API_KEY=tvly-your-tavily-api-key
VIOLA_TAVILY_MAX_RESULTS=5

# Optional LangSmith tracing.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=viola

